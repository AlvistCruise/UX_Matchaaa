<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/bg_item_card"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/ivMatchaImage"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:padding="8dp"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher" /> <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/green_start"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvMatchaName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Matcha Name"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMatchaPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Rp. 24.000"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />
</LinearLayout>
</LinearLayout>